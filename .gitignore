# Data (downloaded and regenerated by scripts/build_dataset.py).
# Only the school-level table and its metadata are versioned: the INEP server refuses
# downloads from outside Brazil (e.g. Google Colab), so the notebooks use this table.
data/*
!data/processed/
data/processed/*
!data/processed/schools_enem2025_censo2024.parquet
!data/processed/schools_enem2025_censo2024.json

